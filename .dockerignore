# secrets (mounted at runtime, never baked into image)
.secrets/

# python
**/__pycache__/
*.py[cod]
.python-version

# venvs
.venv*
venv/

# test / coverage / lint
.cache
.coverage
.coverage.*
.pytest_cache/
.ruff_cache/
coverage.xml
htmlcov/

# editor
.claude/
.vscode/

# wip
**/*.wip.py
**/*.wip.md

# databases
*.db
*.sql

# samples / config / notes (kept in repo, omitted from image)
*.sample.*
config/
notes/

# bot assets
apps/bot/assets/doombot-seed/

# disabled apps (manifest still needed for uv workspace sync)
apps/chat/
!apps/chat/pyproject.toml

# misc
backups/
wip/

# allow workspace metadata for test runner
!pyproject.toml
