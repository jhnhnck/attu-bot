# Path to the TOML configuration file
# All secrets and read-only config (tokens, database URL, WebAuthn settings, etc.)
# are stored in the TOML file pointed to by this variable.
ATTU_CONFIG_FILE='./assets/attu-bot.toml'

# MongoDB authentication credentials (L5)
# These are used by the mongo container on first initialization (MONGO_INITDB_*).
# The same credentials must appear in the [database] url in attu-bot.toml.
# ⚠️  Existing deployments: MONGO_INITDB_* only apply on fresh volume init.
#     Create the user manually via mongosh before enabling auth on a running instance.
MONGO_ROOT_USER='attubot'
MONGO_ROOT_PASS=

