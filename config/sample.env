# Path to the TOML configuration file
# All secrets and read-only config (tokens, database URL, etc.)
# are stored in the TOML file pointed to by this variable.
ATTU_CONFIG_FILE='./.secrets/attu-bot.toml'

# PostgreSQL credentials (used by the postgres and ferret containers)
POSTGRES_DB='ferretdb'
POSTGRES_USER='ferretdb'
POSTGRES_PASSWORD=
